# .env.example
# Flask secret key
SECRET_KEY=your-secret-key

# MongoDB Atlas URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hiretest?retryWrites=true&w=majority

# Redis URL (for Celery broker / result backend)
REDIS_URL=redis://localhost:6379/0

# Optional AI API key for test‑case generation
AI_API_KEY=your-api-key
